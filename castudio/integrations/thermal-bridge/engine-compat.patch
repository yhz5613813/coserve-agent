+"""Surface-bound clipping in physical coordinates; P1 barycentric quadrature."""
+import numpy as np
+import trimesh
+from thermal_legacy.scenario_cases import clipped_quadrature
+from thermal_legacy.geometry import project
+
+
+def patch_coordinates(points,patch):
+    u,v=np.asarray(patch['u_axis']),np.asarray(patch['v_axis'])
+    basis=np.stack((u,v,np.cross(u,v)),axis=1)
+    return (np.asarray(points)-patch['center_m'])@basis
+
+
+def patch_box(patch,scale):
+    eps=max(float(scale)*1e-7,1e-10)
+    return dict(min_m=[-patch['width_m']/2,-patch['height_m']/2,-eps],
+                max_m=[patch['width_m']/2,patch['height_m']/2,eps])
+
+
+def patch_inside(points,patch):
+    from thermal_legacy.scenario_cases import box_inside
+    return box_inside(patch_coordinates(points,patch),patch_box(patch,max(patch['width_m'],patch['height_m'])))
+
+
+def selected_quadrature(triangles,display_points,display_faces,selected_faces,box=None,patch=None):
+    triangles=np.asarray(triangles,float)
+    local=patch_coordinates(triangles,patch) if patch else triangles
+    clipping=patch_box(patch,np.ptp(triangles,axis=(0,1)).max()) if patch else box
+    parent,bary,weight=clipped_quadrature(local,clipping)
+    if not len(weight):return parent,bary,weight
+    query=np.einsum('qi,qic->qc',bary,triangles[parent])
+    original=trimesh.Trimesh(vertices=display_points,faces=display_faces,process=False)
+    _,_,ids=project(original,query)
+    selected=np.zeros(len(display_faces),bool);selected[np.asarray(selected_faces,dtype=int)]=True
+    keep=selected[ids]
+    if box and patch:
+        from thermal_legacy.scenario_cases import box_inside
+        keep&=box_inside(query,box)
+    return parent[keep],bary[keep],weight[keep]
+
+
+def _split(poly,triangle,normal,offset,eps):
+    values=(np.asarray(poly)@triangle)@normal-offset
+    if np.all(values>=-eps) or np.all(values<=eps):return [poly]
+    halves=[[],[]]
+    for sign,out in zip((1,-1),halves):
+        for i,a in enumerate(poly):
+            b=poly[(i+1)%len(poly)];x,y=values[i]*sign,values[(i+1)%len(poly)]*sign
+            inside=x>=-eps;other=y>=-eps
+            if inside:out.append(a)
+            if inside!=other:out.append(a+(b-a)*(x/(x-y)))
+    return [p for p in halves if len(p)>=3]
+
+
+def partition_quadrature(triangles,patches):
+    """Partition surface triangles at patch edges before integrating coefficients.
+
+    Keeps both sides of every cut so overlapping cooling overrides can be
+    evaluated at quadrature points without dropping or duplicating area.
+    """
+    triangles=np.asarray(triangles,float);scale=max(float(np.ptp(triangles,axis=(0,1)).max()),1e-9)
+    eps=max(scale*1e-10,1e-13);prepared=[]
+    for patch in patches:
+        u,v=np.asarray(patch['u_axis']),np.asarray(patch['v_axis']);n=np.cross(u,v)
+        center=np.asarray(patch['center_m']);half=[patch['width_m']/2,patch['height_m']/2,max(scale*1e-7,1e-10)]
+        axes=[u,v,n];extent=sum((abs(a)*h for a,h in zip(axes,half)),np.zeros(3))
+        planes=[(axis,float(center@axis+sign*h)) for axis,h in zip(axes,half) for sign in (-1,1)]
+        prepared.append((center-extent,center+extent,planes))
+    parents=[];barys=[];weights=[]
+    rule=np.array([[2/3,1/6,1/6],[1/6,2/3,1/6],[1/6,1/6,2/3]])
+    for index,tri in enumerate(triangles):
+        pieces=[list(np.eye(3))]
+        for lo,hi,planes in prepared:
+            if np.any(tri.max(axis=0)<lo-eps) or np.any(tri.min(axis=0)>hi+eps):continue
+            for normal,offset in planes:
+                pieces=[part for poly in pieces for part in _split(poly,tri,normal,offset,eps)]
+                if len(pieces)>4096:raise ValueError('重叠散热区域过多，请减少区域或细化网格')
